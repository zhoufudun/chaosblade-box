1、项目执行
    clean package

2、执行
docker buildx build \
--platform linux/arm64 \
-t chaosblade-box:arm64-v1.1.0 .

3、删除正在运行的chaosblade-box容器
    docker rm 07532158b82831a4c5dafff908ed33e787c5b24bc567f0f52e5117157050cff

4、删除docker 镜像
    docker rmi chaosblade-box:arm64-v1.1.0

5、docker运行：
    docker run -d \
      --name chaosblade-box \
      --network chaos-net \
      -p 8001:7001 \
      chaosblade-box:arm64-v1.1.0


其他：
    1、mysql部署
        docker run -d \
          --name mysql-server \
          --network chaos-net \
          -e MYSQL_ROOT_PASSWORD=root123456 \
          -e MYSQL_DATABASE=chaosblade \
          -p 3307:3306 \
          mysql:8.0
    2、网络创建
        docker network create chaos-net



1、Docker 部署（端口 8001）
        # 1. 启动 MySQL
        docker run -d --name mysql-server \
          -p 3306:3306 \
          -e MYSQL_ROOT_PASSWORD=root123456 \
          -e MYSQL_DATABASE=chaosblade \
          mysql:8.0

        # 2. 启动 chaosblade-box
        docker run -d --name chaosblade-box \
          -p 8001:7001 \
          --link mysql-server:mysql-server \
          chaosblade-box:arm64-v1.1.0-1 \
          --spring.datasource.url="jdbc:mysql://mysql-server:3306/chaosblade?characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true" \
          --spring.datasource.username=root \
          --spring.datasource.password=root123456
        访问：http://localhost:8001

2、K8s 部署（端口 9001）
        # 1. 安装
        helm install chaosblade-box /Users/zhoufudun/chaosblade-box-1.1.0.tgz \
          -n chaosblade \
          --set box.repository=chaosblade-box \
          --set box.version=arm64-v1.1.0-1 \
          --set box.pullPolicy=Never \
          --set spring.datasource.url="jdbc:mysql://host.docker.internal:3306/chaosblade?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true" \
          --set spring.datasource.username=root \
          --set spring.datasource.password=root123456

        # 2. 改端口为 9001（避免和 Docker box 冲突）
        kubectl patch svc chaosblade-box -n chaosblade --type='json' \
          -p='[{"op":"replace","path":"/spec/ports/0/port","value":9001}]'
        访问：http://localhost:9001


3、卸载
        # Docker
        docker stop chaosblade-box && docker rm chaosblade-box

        # K8s
        helm uninstall chaosblade-box -n chaosblade
